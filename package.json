{
  "name": "dm-label-printers-app",
  "version": "0.1.3",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "description": "Customer-facing companion to the native DM Label Printer Windows app — remote operate and monitor your installed device.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "node --test src/app/pairing-code.test.ts src/app/shared/*.test.ts scripts/*.test.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "check": "npm test && npm run build:prod && npm run audit:prod",
    "invalidate:cf:prod": "aws cloudfront create-invalidation --distribution-id E15UYTBZU09NW --paths \"/index.html\" --profile dm",
    "deploy:prod": "npm run build:prod && node scripts/deploy-prod.mjs"
  },
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/router": "21.2.25",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.25",
    "@angular/cli": "21.2.25",
    "@angular/compiler-cli": "21.2.25",
    "typescript": "~5.9.3"
  }
}
